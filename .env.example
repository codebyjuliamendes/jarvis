# ============================================================
# Jarvis - configuração
# Copie para .env e preencha. NUNCA comite o .env.
# ============================================================

# ---------- Telegram (obrigatório) ----------
# Crie um bot com o @BotFather no Telegram e cole o token aqui.
TELEGRAM_BOT_TOKEN=

# Seu ID numérico do Telegram (o bot te informa se você mandar /start sem isso).
# Vários IDs separados por vírgula.
TELEGRAM_ALLOWED_USER_IDS=

# ---------- Ollama (obrigatório) ----------
OLLAMA_URL=http://127.0.0.1:11434
# Modelos com suporte a ferramentas: qwen2.5:3b (rápido em CPU), qwen2.5:7b (melhor), llama3.2:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192

# ---------- Comportamento ----------
JARVIS_OWNER_NAME=Julia
JARVIS_TIMEZONE=America/Sao_Paulo
JARVIS_MAX_ITERATIONS=8
JARVIS_HISTORY_LIMIT=40
JARVIS_DB_PATH=data/jarvis.sqlite3

# Pastas que o Jarvis pode ler/escrever (separadas por vírgula).
# Padrão: sua home. Pastas de credenciais (.ssh, .config, .env...) são bloqueadas.
JARVIS_ALLOWED_ROOTS=
JARVIS_WORKSPACE=

# Terminal: permita comandos? (true/false). Comandos destrutivos são bloqueados.
JARVIS_SHELL_ENABLED=true
JARVIS_SHELL_TIMEOUT=120

# Voz: transcrever áudios do Telegram (instale com ./scripts/setup_voice.sh)
JARVIS_WHISPER_ENABLED=true
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_LANGUAGE=pt

# ---------- Integrações (opcionais) ----------
# Obsidian: caminho do seu vault
OBSIDIAN_VAULT=

# Notion: crie uma integração em https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DEFAULT_PAGE=

# Stripe: use uma chave restrita (rk_) ou de teste (sk_test_) sempre que possível
STRIPE_API_KEY=

# GitHub: token com escopo repo (https://github.com/settings/tokens)
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# Google Calendar/Gmail: coloque o credentials.json aqui e rode scripts/google_auth.py
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json

# Briefing e memória local
JARVIS_BRIEFING_ENABLED=true
JARVIS_BRIEFING_HOUR=6
JARVIS_BRIEFING_MINUTE=0
JARVIS_BRIEFING_MAX_ITERATIONS=4
JARVIS_RAG_ENABLED=true
JARVIS_RAG_MODEL=nomic-embed-text
JARVIS_RAG_ROOTS=
JARVIS_RAG_EXTENSIONS=.md,.txt,.pdf,.docx,.csv,.xlsx
# Busca: vector (embeddings), bm25 (palavras, FTS5, sem Ollama) ou hybrid (as duas
# combinadas por Reciprocal Rank Fusion). Ver a seção RAG do README.
JARVIS_RAG_MODE=vector
# k do RRF (só no modo hybrid). 60 é o valor do artigo original.
JARVIS_RAG_RRF_K=60
# Prefixos search_document:/search_query: do nomic-embed-text: auto, true ou false.
# Trocar este valor (ou o modelo) re-embeda os arquivos no próximo /reindex.
JARVIS_RAG_PREFIXES=false
# auto (sqlite-vec se carregar; senão NumPy), sqlite-vec ou numpy
JARVIS_RAG_VECTOR_BACKEND=auto

# Microsoft 365 (Outlook/Teams) via Graph
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT=organizations
MS_GRAPH_TOKEN=
MS_GRAPH_SCOPES=User.Read,Mail.Read,Mail.Send,Calendars.ReadWrite,Chat.Read,Team.ReadBasic.All,Channel.ReadBasic.All

# Voz de saída (edge-tts)
JARVIS_TTS_ENABLED=true
JARVIS_TTS_AUTO=false
JARVIS_TTS_VOICE=pt-BR-FranciscaNeural
JARVIS_TTS_RATE=+0%
JARVIS_TTS_MAX_CHARS=3000

# ---------- Avaliações (evals/) ----------
# MLflow é opcional (requirements-evals.txt). Sem ele, os evals rodam e só avisam.
# Padrão: sqlite local em evals/mlflow.db, artefatos em evals/mlartifacts/.
JARVIS_MLFLOW_ENABLED=true
JARVIS_MLFLOW_TRACKING_URI=
JARVIS_MLFLOW_EXPERIMENT=jarvis-evals

# ---------- Observabilidade ----------
# Métricas por requisição (latência, tokens, ferramentas) num SQLite próprio,
# separado do histórico. Resumo no Telegram com /metrics.
JARVIS_METRICS_ENABLED=true
# Padrão: data/metrics.sqlite3 (ao lado de JARVIS_DB_PATH)
JARVIS_METRICS_DB_PATH=
# Logs: text (padrão, formato de sempre) ou json (uma linha JSON por evento,
# com request_id). Nível: DEBUG, INFO, WARNING...
JARVIS_LOG_FORMAT=text
JARVIS_LOG_LEVEL=INFO
