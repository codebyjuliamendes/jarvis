 {
  "type": "function",
  "function": {
   "name": "github",
   "description": "Consulta e age no GitHub via API: repositórios, issues, pull requests, commits, criar issue e comentar. Requer GITHUB_TOKEN.",
   "parameters": {
    "type": "object",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "list_repos",
       "repo_info",
       "list_issues",
       "get_issue",
       "list_prs",
       "get_pr",
       "recent_commits",
       "create_issue",
       "comment_issue"
      ],
      "description": "Ação a executar."
     },
     "repo": {
      "type": "string",
      "description": "Repositório no formato owner/nome (opcional se GITHUB_DEFAULT_REPO)."
     },
     "number": {
      "type": "integer",
      "description": "Número da issue ou PR."
     },
     "title": {
      "type": "string",
      "description": "Título (create_issue)."
     },
     "body": {
      "type": "string",
      "description": "Corpo/comentário."
     },
     "state": {
      "type": "string",
      "enum": [
       "open",
       "closed",
       "all"
      ],
      "description": "Filtro de estado (padrão open)."
     },
     "limit": {
      "type": "integer",
      "description": "Máximo de itens (padrão 10)."
     }
    },
    "required": [
     "action"
    ]
   }
  }
 },
